#!/usr/bin/python3
"""Bounded RPC requests; scan/apply jobs run outside rpcd and share one lock."""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time

RUN = Path('/run/u30pro-wifi-relay')
NATIVE = '/usr/share/ucode/mu300/wifi-relay.uc'
ACTIONS = ('scan', 'connect', 'up', 'disconnect', 'forget')


def write(name, value):
    path = RUN / (name + '.tmp')
    path.write_text(json.dumps(value))
    path.replace(RUN / name)


def native(request):
    result = subprocess.run(['/usr/bin/ucode', NATIVE], input=json.dumps(request),
                            capture_output=True, text=True, timeout=25)
    # Never include stderr or request fields in RPC errors: they may contain keys.
    try:
        reply = json.loads(result.stdout)
    except ValueError:
        raise ValueError('relay_backend_failed') from None
    if result.returncode and reply.get('ok') is not False:
        raise ValueError('relay_backend_failed')
    return reply


def start(request):
    action = request.get('action')
    if action not in ACTIONS:
        raise ValueError('invalid_relay_action')
    if set(request) - {'action', 'ssid', 'password', 'encryption', 'ubus_rpc_session'}:
        raise ValueError('invalid_relay_request')
    request.pop('ubus_rpc_session', None)
    if action == 'connect':
        ssid, password = request.get('ssid'), request.get('password', '')
        if not isinstance(ssid, str) or not 1 <= len(ssid.encode()) <= 32 or any(c in ssid for c in '\0\r\n'):
            raise ValueError('invalid_relay_ssid')
        if not isinstance(password, str) or len(password.encode()) > 64 or any(c in password for c in '\0\r\n'):
            raise ValueError('invalid_relay_key')
        if request.get('encryption') not in ('none', 'psk2', 'sae-mixed', 'sae', 'owe'):
            raise ValueError('invalid_relay_encryption')
    lock = (RUN / 'lock').open('a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        raise ValueError('relay_busy') from None
    try:
        write('request.json', request)
        write('job.json', dict(pending=True, action=action, id=time.time_ns()))
        subprocess.Popen([sys.executable, __file__, 'worker', str(lock.fileno())],
                         pass_fds=(lock.fileno(),), start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        (RUN / 'request.json').unlink(missing_ok=True)
        write('job.json', dict(pending=False, action=action, ok=False, error='relay_start_failed'))
        raise
    finally:
        lock.close()  # inherited descriptor keeps the lock until worker exits
    return dict(ok=True, pending=True)


def worker(fd):
    job = json.loads((RUN / 'job.json').read_text()) if (RUN / 'job.json').exists() else {}
    try:
        request = json.loads((RUN / 'request.json').read_text())
        (RUN / 'request.json').unlink()
        result = native(request)
        write('job.json', dict(result, pending=False, action=request['action'], id=job.get('id')))
    except Exception:
        write('job.json', dict(ok=False, pending=False, error='relay_job_failed'))
    finally:
        (RUN / 'request.json').unlink(missing_ok=True)
        os.close(fd)


def main():
    product = Path('/etc/mu300/model').read_text().strip()
    if product not in ('u30pro', 'f50pro'):
        raise ValueError('relay_unsupported')
    os.umask(0o077)
    RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
    operation = sys.argv[1]
    if operation == 'worker':
        worker(int(sys.argv[2]))
        return
    if operation == 'start':
        reply = start(json.load(sys.stdin))
    elif operation == 'status':
        state = native(dict(action='status'))
        if state.get('ok') is False:
            raise ValueError(state.get('error', 'relay_backend_failed'))
        job = json.loads((RUN / 'job.json').read_text()) if (RUN / 'job.json').exists() else {}
        # A killed worker must not leave the page disabled indefinitely.
        if job.get('pending'):
            with (RUN / 'lock').open('a') as lock:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    job = dict(ok=False, pending=False, error='relay_job_interrupted')
                    write('job.json', job)
                except BlockingIOError:
                    pass
        reply = dict(ok=True, state=state, job=job)
    else:
        raise ValueError('invalid_relay_action')
    print(json.dumps(reply))


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        reason = str(error) if isinstance(error, ValueError) else 'relay_backend_failed'
        print(json.dumps(dict(ok=False, error=reason)))
